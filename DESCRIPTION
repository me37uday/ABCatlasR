Package: ABCatlas
Title: Release-Aware Access to Allen Brain Cell Atlas Data in R
Version: 0.99.0
Authors@R: c(
    person("Uday", "Rangaswamy",
        role = "aut",
        email = "uday.rangaswamy@ieo.it"),
    person("Mahdi", "Komeili",
        role = c("aut", "cre"),
        email = "mahdi.komeili1999@gmail.com",
        comment = c(ORCID = "0009-0000-3760-5327"))
